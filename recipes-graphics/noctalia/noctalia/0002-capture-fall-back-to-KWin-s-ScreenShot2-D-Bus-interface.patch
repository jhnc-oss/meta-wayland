diff --git a/src/capture/kwin_screenshot_capture.cpp b/src/capture/kwin_screenshot_capture.cpp
new file mode 100644
index 000000000..71db14926
--- /dev/null
+++ b/src/capture/kwin_screenshot_capture.cpp
@@ -0,0 +1,312 @@
+#include "capture/kwin_screenshot_capture.h"
+
+#include "core/log.h"
+#include "dbus/session_bus.h"
+#include "wayland/wayland_connection.h"
+
+#include <cerrno>
+#include <chrono>
+#include <cstring>
+#include <fcntl.h>
+#include <map>
+#include <poll.h>
+#include <sdbus-c++/sdbus-c++.h>
+#include <unistd.h>
+#include <utility>
+#include <vector>
+
+namespace {
+
+  constexpr Logger kLog("kwin_screenshot");
+
+  const sdbus::ServiceName kServiceName{"org.kde.KWin.ScreenShot2"};
+  const sdbus::ObjectPath kObjectPath{"/org/kde/KWin/ScreenShot2"};
+  constexpr auto kInterface = "org.kde.KWin.ScreenShot2";
+
+  constexpr std::chrono::milliseconds kPipeTimeout{5000};
+
+  // QImage::Format values KWin hands out for screenshots.
+  constexpr std::uint32_t kFormatRgb32 = 4;
+  constexpr std::uint32_t kFormatArgb32 = 5;
+  constexpr std::uint32_t kFormatArgb32Premultiplied = 6;
+  constexpr std::uint32_t kFormatRgbx8888 = 16;
+  constexpr std::uint32_t kFormatRgba8888 = 17;
+  constexpr std::uint32_t kFormatRgba8888Premultiplied = 18;
+
+  [[nodiscard]] bool serviceHasOwner(SessionBus& bus) {
+    try {
+      auto proxy = sdbus::createProxy(
+          bus.connection(), sdbus::ServiceName{"org.freedesktop.DBus"}, sdbus::ObjectPath{"/org/freedesktop/DBus"}
+      );
+      bool hasOwner = false;
+      proxy->callMethod("NameHasOwner")
+          .onInterface("org.freedesktop.DBus")
+          .withArguments(std::string{kServiceName})
+          .storeResultsTo(hasOwner);
+      return hasOwner;
+    } catch (const sdbus::Error& e) {
+      kLog.debug("NameHasOwner failed: {}", e.getMessage());
+      return false;
+    }
+  }
+
+  [[nodiscard]] std::optional<std::uint32_t> readUint(const std::map<std::string, sdbus::Variant>& results, const char* key) {
+    const auto it = results.find(key);
+    if (it == results.end()) {
+      return std::nullopt;
+    }
+    try {
+      if (it->second.containsValueOfType<std::uint32_t>()) {
+        return it->second.get<std::uint32_t>();
+      }
+      if (it->second.containsValueOfType<std::int32_t>()) {
+        return static_cast<std::uint32_t>(it->second.get<std::int32_t>());
+      }
+      if (it->second.containsValueOfType<std::uint64_t>()) {
+        return static_cast<std::uint32_t>(it->second.get<std::uint64_t>());
+      }
+    } catch (const sdbus::Error&) {
+    }
+    return std::nullopt;
+  }
+
+  [[nodiscard]] bool readPipe(int fd, std::size_t size, std::vector<std::uint8_t>& out, std::string& error) {
+    out.resize(size);
+    std::size_t total = 0;
+    const auto deadline = std::chrono::steady_clock::now() + kPipeTimeout;
+    while (total < size) {
+      const auto remaining =
+          std::chrono::duration_cast<std::chrono::milliseconds>(deadline - std::chrono::steady_clock::now());
+      if (remaining.count() <= 0) {
+        error = "timed out reading screenshot pipe";
+        return false;
+      }
+      pollfd pfd{.fd = fd, .events = POLLIN, .revents = 0};
+      const int ready = poll(&pfd, 1, static_cast<int>(remaining.count()));
+      if (ready < 0) {
+        if (errno == EINTR) {
+          continue;
+        }
+        error = std::string{"poll on screenshot pipe failed: "} + std::strerror(errno);
+        return false;
+      }
+      if (ready == 0) {
+        error = "timed out reading screenshot pipe";
+        return false;
+      }
+      const ssize_t n = read(fd, out.data() + total, size - total);
+      if (n < 0) {
+        if (errno == EINTR || errno == EAGAIN) {
+          continue;
+        }
+        error = std::string{"read from screenshot pipe failed: "} + std::strerror(errno);
+        return false;
+      }
+      if (n == 0) {
+        error = "screenshot pipe closed early";
+        return false;
+      }
+      total += static_cast<std::size_t>(n);
+    }
+    return true;
+  }
+
+  [[nodiscard]] bool convertToRgba(
+      const std::vector<std::uint8_t>& raw, std::uint32_t width, std::uint32_t height, std::uint32_t stride,
+      std::uint32_t format, std::vector<std::uint8_t>& out
+  ) {
+    bool bgra = false;
+    bool hasAlpha = true;
+    switch (format) {
+    case kFormatRgb32:
+      bgra = true;
+      hasAlpha = false;
+      break;
+    case kFormatArgb32:
+    case kFormatArgb32Premultiplied:
+      bgra = true;
+      break;
+    case kFormatRgbx8888:
+      hasAlpha = false;
+      break;
+    case kFormatRgba8888:
+    case kFormatRgba8888Premultiplied:
+      break;
+    default:
+      return false;
+    }
+
+    out.resize(static_cast<std::size_t>(width) * static_cast<std::size_t>(height) * 4U);
+    for (std::uint32_t y = 0; y < height; ++y) {
+      const auto* row = raw.data() + static_cast<std::size_t>(y) * stride;
+      auto* dst = out.data() + static_cast<std::size_t>(y) * width * 4U;
+      for (std::uint32_t x = 0; x < width; ++x) {
+        const auto* px = row + static_cast<std::size_t>(x) * 4U;
+        if (bgra) {
+          dst[0] = px[2];
+          dst[1] = px[1];
+          dst[2] = px[0];
+        } else {
+          dst[0] = px[0];
+          dst[1] = px[1];
+          dst[2] = px[2];
+        }
+        dst[3] = hasAlpha ? px[3] : 255;
+        dst += 4;
+      }
+    }
+    return true;
+  }
+
+} // namespace
+
+struct KwinScreenshotCapture::Request {
+  int readFd = -1;
+  bool cancelled = false;
+
+  ~Request() {
+    if (readFd >= 0) {
+      close(readFd);
+    }
+  }
+};
+
+KwinScreenshotCapture::KwinScreenshotCapture(SessionBus& bus) : m_bus(bus) {
+  m_available = serviceHasOwner(bus);
+  if (m_available) {
+    kLog.info("using org.kde.KWin.ScreenShot2 for screen capture");
+  }
+}
+
+KwinScreenshotCapture::~KwinScreenshotCapture() { cancelInFlight(); }
+
+void KwinScreenshotCapture::capture(
+    const WaylandOutput& output, std::optional<LogicalRect> region, bool includeCursor, CompletionCallback onComplete
+) {
+  if (m_busy) {
+    if (onComplete) {
+      onComplete(std::nullopt, "capture already in progress");
+    }
+    return;
+  }
+  if (!m_available) {
+    m_available = serviceHasOwner(m_bus);
+  }
+  if (!m_available) {
+    if (onComplete) {
+      onComplete(std::nullopt, "org.kde.KWin.ScreenShot2 unavailable");
+    }
+    return;
+  }
+
+  int fds[2] = {-1, -1};
+  if (pipe2(fds, O_CLOEXEC) < 0) {
+    if (onComplete) {
+      onComplete(std::nullopt, std::string{"failed to create screenshot pipe: "} + std::strerror(errno));
+    }
+    return;
+  }
+
+  auto request = std::make_shared<Request>();
+  request->readFd = fds[0];
+
+  m_busy = true;
+  m_onComplete = std::move(onComplete);
+  m_request = request;
+
+  if (m_proxy == nullptr) {
+    m_proxy = sdbus::createProxy(m_bus.connection(), kServiceName, kObjectPath);
+  }
+
+  std::map<std::string, sdbus::Variant> options;
+  options["include-cursor"] = sdbus::Variant(includeCursor);
+  options["native-resolution"] = sdbus::Variant(true);
+  // The shell hides its own overlays before capturing; keep the bar in the picture like screencopy does.
+  options["hide-caller-windows"] = sdbus::Variant(false);
+
+  auto onReply = [this, request](std::optional<sdbus::Error> error, std::map<std::string, sdbus::Variant> results) {
+    if (request->cancelled) {
+      return;
+    }
+    if (error.has_value()) {
+      this->onReply(request, std::nullopt, std::string{"KWin refused the screenshot: "} + error->getMessage());
+      return;
+    }
+
+    const auto width = readUint(results, "width");
+    const auto height = readUint(results, "height");
+    const auto stride = readUint(results, "stride");
+    const auto format = readUint(results, "format");
+    if (!width || !height || !stride || !format || *width == 0 || *height == 0 || *stride < *width * 4U) {
+      this->onReply(request, std::nullopt, "KWin returned an unusable screenshot description");
+      return;
+    }
+
+    std::vector<std::uint8_t> raw;
+    std::string readError;
+    if (!readPipe(request->readFd, static_cast<std::size_t>(*stride) * *height, raw, readError)) {
+      this->onReply(request, std::nullopt, std::move(readError));
+      return;
+    }
+
+    ScreencopyImage image;
+    image.width = static_cast<int>(*width);
+    image.height = static_cast<int>(*height);
+    image.yInvert = false;
+    if (!convertToRgba(raw, *width, *height, *stride, *format, image.rgba)) {
+      this->onReply(request, std::nullopt, "unsupported KWin screenshot format " + std::to_string(*format));
+      return;
+    }
+    this->onReply(request, std::move(image), {});
+  };
+
+  try {
+    if (region.has_value() && region->width > 0 && region->height > 0) {
+      m_proxy->callMethodAsync("CaptureArea")
+          .onInterface(kInterface)
+          .withArguments(
+              static_cast<std::int32_t>(output.logicalX + region->x),
+              static_cast<std::int32_t>(output.logicalY + region->y), static_cast<std::int32_t>(region->width),
+              static_cast<std::int32_t>(region->height), options, sdbus::UnixFd{fds[1]}
+          )
+          .uponReplyInvoke(onReply);
+    } else {
+      m_proxy->callMethodAsync("CaptureScreen")
+          .onInterface(kInterface)
+          .withArguments(output.connectorName, options, sdbus::UnixFd{fds[1]})
+          .uponReplyInvoke(onReply);
+    }
+  } catch (const sdbus::Error& e) {
+    close(fds[1]);
+    this->onReply(request, std::nullopt, std::string{"screenshot request failed: "} + e.getMessage());
+    return;
+  }
+  // sdbus duplicated the write end into the message; KWin owns the only remaining writer now.
+  close(fds[1]);
+}
+
+void KwinScreenshotCapture::cancelInFlight() {
+  if (m_request) {
+    m_request->cancelled = true;
+    m_request.reset();
+  }
+  m_busy = false;
+  m_onComplete = {};
+}
+
+void KwinScreenshotCapture::onReply(
+    const std::shared_ptr<Request>& request, std::optional<ScreencopyImage> image, std::string error
+) {
+  if (request != m_request) {
+    return;
+  }
+  m_request.reset();
+  m_busy = false;
+  auto onComplete = std::exchange(m_onComplete, {});
+  if (!error.empty()) {
+    kLog.warn("{}", error);
+  }
+  if (onComplete) {
+    onComplete(std::move(image), std::move(error));
+  }
+}
