+class SessionBus;
+struct WaylandOutput;
+
+namespace sdbus {
+  class IProxy;
+}
+
+// Screen capture through KWin's org.kde.KWin.ScreenShot2 D-Bus interface, for
+// sessions where the compositor offers no wlr-screencopy global. The caller's
+// desktop entry must list org.kde.KWin.ScreenShot2 in X-KDE-DBUS-Restricted-Interfaces.
+class KwinScreenshotCapture {
+public:
+  using CompletionCallback = std::function<void(std::optional<ScreencopyImage>, std::string error)>;
+
+  explicit KwinScreenshotCapture(SessionBus& bus);
+  ~KwinScreenshotCapture();
+
+  KwinScreenshotCapture(const KwinScreenshotCapture&) = delete;
+  KwinScreenshotCapture& operator=(const KwinScreenshotCapture&) = delete;
+
+  [[nodiscard]] bool available() const noexcept { return m_available; }
+  [[nodiscard]] bool busy() const noexcept { return m_busy; }
+
+  void capture(
+      const WaylandOutput& output, std::optional<LogicalRect> region, bool includeCursor, CompletionCallback onComplete
+  );
+  void cancelInFlight();
+
+private:
+  struct Request;
+
+  void onReply(const std::shared_ptr<Request>& request, std::optional<ScreencopyImage> image, std::string error);
+
+  SessionBus& m_bus;
+  std::unique_ptr<sdbus::IProxy> m_proxy;
+  std::shared_ptr<Request> m_request;
+  bool m_available = false;
+  bool m_busy = false;
+  CompletionCallback m_onComplete;
+};
