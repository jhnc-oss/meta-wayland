From caaad479e7de2b15cac20195b65f7d73b1ed641b Mon Sep 17 00:00:00 2001
From: Lemmy <studio@quadbyte.net>
Date: Thu, 24 Sep 2026 23:51:22 -0400
Subject: [PATCH] fix(templates): move umbriel scratchpad border colors to a
 window rule

Upstream-Status: Backport [https://github.com/noctalia-dev/noctalia/commit/caaad479e7de2b15cac20195b65f7d73b1ed641b]
---
 assets/templates/umbriel/umbriel.toml | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/assets/templates/umbriel/umbriel.toml b/assets/templates/umbriel/umbriel.toml
index 0361a62292..dca659b9d0 100644
--- a/assets/templates/umbriel/umbriel.toml
+++ b/assets/templates/umbriel/umbriel.toml
@@ -12,11 +12,14 @@ backdrop = "#{{colors.surface_variant.default.hex_stripped}}FF"
 [colors.border]
 focused = "#{{colors.primary.default.hex_stripped}}FF"
 unfocused = "#{{colors.surface_variant.default.hex_stripped}}FF"
-scratchpad_focused = "#{{colors.tertiary.default.hex_stripped}}FF"
-scratchpad_unfocused = "#{{colors.tertiary_container.default.hex_stripped}}FF"
 outer = "#{{colors.terminal_background.default.hex_stripped}}FF"
 
 [colors.overview]
 background_tint = "#{{colors.surface.default.hex_stripped}}88"
 badge = "#{{colors.primary.default.hex_stripped}}FF"
 workspace_background = "#{{colors.surface.default.hex_stripped}}FF"
+
+[[window_rule]]
+match.is_scratchpad = true
+border_color_focused = "#{{colors.tertiary.default.hex_stripped}}FF"
+border_color_unfocused = "#{{colors.tertiary_container.default.hex_stripped}}FF"
