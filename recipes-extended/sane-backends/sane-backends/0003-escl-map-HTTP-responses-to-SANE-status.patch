@@ -47,18 +47,15 @@ void
 escl_delete(const ESCL_Device *device, char *uri)
 {
     CURL *curl_handle = NULL;
-    long answer = 0;
 
     if (uri == NULL)
         return;
     curl_handle = curl_easy_init();
     if (curl_handle != NULL) {
         escl_curl_url(curl_handle, device, uri);
