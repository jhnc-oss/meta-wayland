From 48b6452c1c6c706f39c8fb53aecb9066752d17dc Mon Sep 17 00:00:00 2001
From: Ordissimo <thierry@ordissimo.com>
Date: Sat, 18 Jul 2026 22:22:35 +0200
Subject: [PATCH] escl: map HTTP responses to SANE status

Upstream-Status: Backport [https://gitlab.com/sane-project/backends/-/commit/51c6417943bd2e9b205f9d9fbdee92d315d341b6]

---
 backend/escl/escl.c              | 35 ++++++++++++++++++++++++++++++++
 backend/escl/escl.h              |  1 +
 backend/escl/escl_capabilities.c |  7 +++----
 backend/escl/escl_newjob.c       | 18 +++++-----------
 backend/escl/escl_reset.c        | 16 ++++++---------
 backend/escl/escl_scan.c         | 20 +++++++++---------
 backend/escl/escl_status.c       | 10 ++++-----
 7 files changed, 64 insertions(+), 43 deletions(-)

diff --git a/backend/escl/escl.c b/backend/escl/escl.c
index 6bd34290..30d3c2e7 100644
--- a/backend/escl/escl.c
+++ b/backend/escl/escl.c
@@ -1872,3 +1872,38 @@ escl_curl_url(CURL *handle, const ESCL_Device *device, SANE_String_Const path)
                          device->unix_socket);
     }
 }
+
+SANE_Status
+escl_curl_status(CURL *handle, CURLcode result)
+{
+    long response = 0;
+
+    if (result != CURLE_OK) {
+        DBG(10, "eSCL transport error: %s\n", curl_easy_strerror(result));
+        return SANE_STATUS_IO_ERROR;
+    }
+    if (curl_easy_getinfo(handle, CURLINFO_RESPONSE_CODE, &response) != CURLE_OK)
+        return SANE_STATUS_IO_ERROR;
+    if (response >= 200 && response < 300)
+        return SANE_STATUS_GOOD;
+
+    DBG(10, "eSCL HTTP status: %ld\n", response);
+    switch (response) {
+    case 401:
+    case 403:
+        return SANE_STATUS_ACCESS_DENIED;
+    case 404:
+    case 409:
+        return SANE_STATUS_NO_DOCS;
+    case 423:
+    case 429:
+    case 503:
+        return SANE_STATUS_DEVICE_BUSY;
+    case 400:
+    case 405:
+    case 415:
+        return SANE_STATUS_UNSUPPORTED;
+    default:
+        return SANE_STATUS_IO_ERROR;
+    }
+}
diff --git a/backend/escl/escl.h b/backend/escl/escl.h
index 2dce59bd..4cf3cf3a 100644
--- a/backend/escl/escl.h
+++ b/backend/escl/escl.h
