diff --git a/src/view/view_floating.cpp b/src/view/view_floating.cpp
index 8a1a5c9b..ff94340d 100644
--- a/src/view/view_floating.cpp
+++ b/src/view/view_floating.cpp
@@ -159,6 +159,33 @@ namespace umbriel {
     return true;
   }
 
+  namespace {
+    // The edges a window rule anchor pins per axis.
+    std::array<AxisAnchor, 2> placementAxisAnchors(WindowPositionAnchor anchor) {
+      switch (anchor) {
+      case WindowPositionAnchor::TopLeft:
+        return {AxisAnchor::Start, AxisAnchor::Start};
+      case WindowPositionAnchor::TopRight:
+        return {AxisAnchor::End, AxisAnchor::Start};
+      case WindowPositionAnchor::BottomLeft:
+        return {AxisAnchor::Start, AxisAnchor::End};
+      case WindowPositionAnchor::BottomRight:
+        return {AxisAnchor::End, AxisAnchor::End};
+      case WindowPositionAnchor::Top:
+        return {AxisAnchor::Center, AxisAnchor::Start};
+      case WindowPositionAnchor::Bottom:
+        return {AxisAnchor::Center, AxisAnchor::End};
+      case WindowPositionAnchor::Left:
+        return {AxisAnchor::Start, AxisAnchor::Center};
+      case WindowPositionAnchor::Right:
+        return {AxisAnchor::End, AxisAnchor::Center};
+      case WindowPositionAnchor::Center:
+        return {AxisAnchor::Center, AxisAnchor::Center};
+      }
+      return {AxisAnchor::Start, AxisAnchor::Start};
+    }
+  } // namespace
+
   std::optional<FloatingPoint> View::getFloatingPosition(
       const wlr_box usable, const std::optional<WindowPosition>& position, const std::optional<std::array<int, 2>> size
   ) {
@@ -229,6 +256,8 @@ namespace umbriel {
     }
     if (position) {
       m_floating.rememberPositionFraction(*origin, usable);
+      const auto [anchorX, anchorY] = placementAxisAnchors(position->anchor);
+      m_floating.rememberPlacementAnchor(anchorX, anchorY);
     } else if (const View* parent = transientParent()) {
       // Where the parent is headed, not where its node is mid-animation right after it mapped. A fullscreen parent
       // shows over any panel, so the whole output counts as visible for it.
@@ -439,14 +468,33 @@ namespace umbriel {
     if (geo.width <= 0 || geo.height <= 0) {
       return;
     }
-    if (scheduledSize().width != geo.width || scheduledSize().height != geo.height) {
+    const ClientSize scheduled = scheduledSize();
+    if (scheduled.width != geo.width || scheduled.height != geo.height) {
       // Once the latest compositor size request is committed, a floating
       // client owns its size. Direct assignment avoids an echo configure.
       adoptScheduledSize(geo.width, geo.height);
+      keepPlacementAnchor(scheduled, geo);
       clampFloatingPosition();
     }
   }
 
+  void View::keepPlacementAnchor(ClientSize oldSize, const wlr_box& newSize) {
+    const auto& anchor = m_floating.placementAnchor();
+    if (!anchor || oldSize.width <= 0 || oldSize.height <= 0) {
+      return;
+    }
+    const FloatingPoint origin{.x = layoutTargetX(), .y = layoutTargetY()};
+    const FloatingPoint moved = anchoredGrowthOrigin(
+        origin, {oldSize.width, oldSize.height}, {newSize.width, newSize.height}, (*anchor)[0], (*anchor)[1]
+    );
+    if (moved.x == origin.x && moved.y == origin.y) {
+      return;
+    }
+    // The client has already drawn at the new size, so the origin moves with it rather than animating after it.
+    setPosition(moved.x, moved.y);
+    m_floating.rememberPositionFraction(moved, floatingUsableArea());
+  }
+
   void View::syncFloatingSurfaceClip() {
     if (m_tiled || scheduledFullscreen()) {
       return;
diff --git a/tests/unit/floating.cpp b/tests/unit/floating.cpp
index 8174006a..d22cc0fa 100644
--- a/tests/unit/floating.cpp
+++ b/tests/unit/floating.cpp
@@ -3,6 +3,8 @@
 #include "check.h"
 
 using umbriel::anchoredContentOrigin;
+using umbriel::anchoredGrowthOrigin;
+using umbriel::AxisAnchor;
 using umbriel::centeredOrigin;
 using umbriel::centeredOverShown;
 using umbriel::clampFloatingOrigin;
@@ -367,4 +369,43 @@ UMBRIEL_TEST(aSizeReadsBackAsTheFractionItCameFrom) {
   CHECK(floatingSizeFraction(192, 1920) == 0.1);
 }
 
+// Client-driven growth of an anchored float
+UMBRIEL_TEST(aLeftAnchoredFloatKeepsItsOriginWhenItGrows) {
+  const auto origin = anchoredGrowthOrigin({100, 200}, {400, 300}, {700, 350}, AxisAnchor::Start, AxisAnchor::Start);
+  CHECK_EQ(origin.x, 100);
+  CHECK_EQ(origin.y, 200);
+}
+
+UMBRIEL_TEST(aRightAnchoredFloatGrowsToTheLeft) {
+  const auto origin = anchoredGrowthOrigin({1500, 200}, {400, 300}, {700, 300}, AxisAnchor::End, AxisAnchor::Center);
+  CHECK_EQ(origin.x, 1200);
+  CHECK_EQ(origin.y, 200);
+}
+
+UMBRIEL_TEST(aRightAnchoredFloatShrinksTowardsItsRightEdge) {
+  const auto origin = anchoredGrowthOrigin({1200, 200}, {700, 300}, {400, 300}, AxisAnchor::End, AxisAnchor::Center);
+  CHECK_EQ(origin.x, 1500);
+}
+
+UMBRIEL_TEST(aCenteredFloatGrowsBothWays) {
+  const auto origin = anchoredGrowthOrigin({760, 390}, {400, 300}, {600, 400}, AxisAnchor::Center, AxisAnchor::Center);
+  CHECK_EQ(origin.x, 660);
+  CHECK_EQ(origin.y, 340);
+}
+
+UMBRIEL_TEST(aBottomRightAnchoredFloatKeepsBothFarEdges) {
+  const auto origin = anchoredGrowthOrigin({1500, 760}, {400, 300}, {500, 400}, AxisAnchor::End, AxisAnchor::End);
+  CHECK_EQ(origin.x, 1400);
+  CHECK_EQ(origin.y, 660);
+}
+
+UMBRIEL_TEST(theGeometryRemembersItsPlacementAnchor) {
+  FloatingGeometry floating;
+  CHECK(!floating.placementAnchor().has_value());
+  floating.rememberPlacementAnchor(AxisAnchor::End, AxisAnchor::Center);
+  CHECK(floating.placementAnchor().has_value());
+  CHECK((*floating.placementAnchor())[0] == AxisAnchor::End);
+  CHECK((*floating.placementAnchor())[1] == AxisAnchor::Center);
+}
+
 int main() { return RUN_TESTS(); }
