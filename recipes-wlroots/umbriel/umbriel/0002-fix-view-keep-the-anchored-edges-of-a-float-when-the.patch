 Accepted anchors are `center`, `top_left`, `top_right`, `bottom_left`,
 `bottom_right`, `top`, `bottom`, `left`, and `right`. Right and bottom anchors
-measure inward from those edges.
+measure inward from those edges. When the window later changes its own size,
+the anchored edges stay where they are: a `right` window grows to the left, a
+`center` window in both directions.
 
 ## Scratchpad placement
 
diff --git a/src/view/floating.h b/src/view/floating.h
index 72fe32da..3ebbf3b5 100644
--- a/src/view/floating.h
+++ b/src/view/floating.h
@@ -75,6 +75,36 @@ namespace umbriel {
     return static_cast<int32_t>(committed - requested) >= 0;
   }
 
+  // Which edge of a floating window a position anchor pins on one axis: Start is the left or top edge, End the right or
+  // bottom one, Center neither.
+  enum class AxisAnchor {
+    Start,
+    Center,
+    End,
+  };
+
+  // Where a float placed by a position anchor goes when the client changes its own size. The anchored edge stays where
+  // it is: a right-anchored window grows to the left, a centered one both ways, a left-anchored one keeps its origin.
+  [[nodiscard]] constexpr FloatingPoint anchoredGrowthOrigin(
+      FloatingPoint origin, std::array<int, 2> oldSize, std::array<int, 2> newSize, AxisAnchor x, AxisAnchor y
+  ) {
+    const auto shift = [](int oldLength, int newLength, AxisAnchor anchor) {
+      switch (anchor) {
+      case AxisAnchor::Start:
+        return 0;
+      case AxisAnchor::Center:
+        return (oldLength - newLength) / 2;
+      case AxisAnchor::End:
+        return oldLength - newLength;
+      }
+      return 0;
+    };
+    return {
+        .x = origin.x + shift(oldSize[0], newSize[0], x),
+        .y = origin.y + shift(oldSize[1], newSize[1], y),
+    };
+  }
+
   // Center a window of the given size in `usable`. Floats keep their own size,
   // so this only ever moves them.
   [[nodiscard]] constexpr FloatingPoint centeredOrigin(const wlr_box& usable, int width, int height) {
@@ -143,6 +173,9 @@ namespace umbriel {
     // a different-sized output lands in the same relative spot.
     void rememberPositionFraction(FloatingPoint origin, const wlr_box& usable);
     [[nodiscard]] std::optional<FloatingPoint> restoredOrigin(const wlr_box& usable) const;
+    // The edges a position rule pinned the window to; a client-driven size change keeps them in place.
+    void rememberPlacementAnchor(AxisAnchor x, AxisAnchor y) { m_placementAnchor = {{x, y}}; }
+    [[nodiscard]] const std::optional<std::array<AxisAnchor, 2>>& placementAnchor() const { return m_placementAnchor; }
 
     // Configure-serial handoff. A fully-specified request is the pending basis
     // resize actions accumulate against until the client commits its serial.
@@ -174,6 +207,7 @@ namespace umbriel {
 
     std::optional<std::array<int, 2>> m_size;
     std::optional<std::array<double, 2>> m_posFrac;
+    std::optional<std::array<AxisAnchor, 2>> m_placementAnchor;
     std::optional<uint32_t> m_sizeRequestSerial;
     std::optional<std::array<int, 2>> m_pendingSize;
     std::optional<wlr_box> m_anchor;
