From f223ea7355bdf094413668778829d2c90d66a588 Mon Sep 17 00:00:00 2001
From: From: Markus Volk <f_l_k@t-online.de>
Date: Sat, 29 Aug 2026 17:45:33 +0000
Subject: [PATCH] CMakeLists: allow glaze 8.x

Upstream-Status: Inappropriate
---
 CMakeLists.txt        | 2 +-
 hyprpm/CMakeLists.txt | 4 ++--
 start/CMakeLists.txt  | 4 ++--
 3 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index cf7f53aa..fbefdc0a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -132,7 +132,7 @@ find_package(glslang CONFIG REQUIRED)
 
 find_package(glaze 7...<8 QUIET)
 if(NOT glaze_FOUND)
-  set(GLAZE_VERSION v7.2.0)
+  set(GLAZE_VERSION v8.0.0)
   message(STATUS "glaze dependency not found, retrieving ${GLAZE_VERSION} with FetchContent")
   include(FetchContent)
   FetchContent_Declare(
diff --git a/hyprpm/CMakeLists.txt b/hyprpm/CMakeLists.txt
index 13204ada..790c3cfc 100644
--- a/hyprpm/CMakeLists.txt
+++ b/hyprpm/CMakeLists.txt
@@ -12,10 +12,10 @@ set(CMAKE_CXX_STANDARD 23)
 pkg_check_modules(hyprpm_deps REQUIRED IMPORTED_TARGET tomlplusplus hyprutils>=0.7.0)
 
 if (NOT TARGET glaze::glaze)
-    find_package(glaze 7...<8 QUIET)
+    find_package(glaze 8...<9 QUIET)
 endif()
 if (NOT glaze_FOUND AND NOT TARGET glaze::glaze)
-    set(GLAZE_VERSION v7.2.0)
+    set(GLAZE_VERSION v8.0.0)
     message(STATUS "hyprpm: glaze dependency not found, retrieving ${GLAZE_VERSION} with FetchContent")
     include(FetchContent)
     FetchContent_Declare(
diff --git a/start/CMakeLists.txt b/start/CMakeLists.txt
index 7b21bddc..f9ca2b12 100644
--- a/start/CMakeLists.txt
+++ b/start/CMakeLists.txt
@@ -12,10 +12,10 @@ find_package(PkgConfig REQUIRED)
 pkg_check_modules(starthyprland_deps REQUIRED IMPORTED_TARGET hyprutils>=0.10.3)
 
 if (NOT TARGET glaze::glaze)
-    find_package(glaze 7...<8 QUIET)
+    find_package(glaze 8...<9 QUIET)
 endif()
 if (NOT glaze_FOUND AND NOT TARGET glaze::glaze)
-    set(GLAZE_VERSION v7.2.0)
+    set(GLAZE_VERSION v8.0.0)
     message(STATUS "start: glaze dependency not found, retrieving ${GLAZE_VERSION} with FetchContent")
     include(FetchContent)
     FetchContent_Declare(
